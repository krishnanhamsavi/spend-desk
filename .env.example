# Copy to .env and fill in. .env is gitignored.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=SPEND_DESK_ROLE
SNOWFLAKE_WAREHOUSE=SPEND_DESK_WH
SNOWFLAKE_DATABASE=SPEND_DESK
# Key pair auth. Path to the unencrypted or encrypted .p8 private key.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Local development only. Inside Snowflake the app uses Cortex.
ANTHROPIC_API_KEY=
